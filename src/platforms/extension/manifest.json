{
    "manifest_version": 3,
    "name": "Pocket Buddy",
    "description": "A tiny Buddy companion with optional Home, OpenPets, and My Pets.",
    "version": "__VERSION__",
    "homepage_url": "https://github.com/codysumpter-cloud/Pocket-Buddy",
    "icons": {
        "48": "images/icons/transparent/48x48x1.png",
        "96": "images/icons/transparent/96x96x1.png",
        "128": "images/icons/transparent/128x128x1.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "birb.js"
            ]
        }
    ],
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://openpets.dev/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/*",
                "fonts/Monocraft.otf"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "pocket-buddy@prismtek.dev",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}
